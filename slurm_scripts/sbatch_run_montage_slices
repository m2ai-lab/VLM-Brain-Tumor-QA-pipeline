#!/bin/bash
#SBATCH --job-name=Montage_slices
#SBATCH --time=4:00:00
#SBATCH --partition=cpu
#SBATCH --ntasks-per-node=1
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --output=/home/remote/%u/logs/%x_%j.out
#SBATCH --error=/home/remote/%u/logs/%x_%j.err

# ── Environment isolation (mirrors sbatch_run_best_slice) ─────────────────────
module load miniforge3

export PYTHONNOUSERSITE=1
export PYTHONPATH=""
export LD_LIBRARY_PATH="/home/remote/shghosh/.conda/environments/envs/format/lib:$LD_LIBRARY_PATH"

PYTHON=/home/remote/shghosh/.conda/environments/envs/format/bin/python
SCRIPT=/scratch/group/CX000019_DS1/vlm-brain-mri/QA-BrainTumor-VLM-UCSF-/data_pipeline/montage_slices.py

# ── Run ───────────────────────────────────────────────────────────────────────
# All paths are resolved from config.yaml by default.
# Pass --overwrite to regenerate existing montages.
# Pass --pdgm_id UCSF-PDGM-XXXX to debug a single patient.
echo "Starting montage generation at $(date)"
echo "------------------------------------------------------------"

$PYTHON "$SCRIPT"

echo "------------------------------------------------------------"
echo "Job finished at $(date)"
