#!/bin/bash
#SBATCH --job-name=Orchestration_run
#SBATCH --time=2-00:00:00
#SBATCH --partition=cpu
#SBATCH --ntasks-per-node=1
#SBATCH --nodes=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=20G
#SBATCH --output=/home/remote/%u/logs/Orchestration_%j.out
#SBATCH --error=/home/remote/%u/logs/Orchestration_%j.err
#SBATCH --mail-user=shiv.ghosh@ucsf.edu
#SBATCH --mail-type=ALL

# 1. Load the cluster's Conda module
module load miniforge3

# 2. Prevent "Ghost" package leakage (The root of our earlier problems)
export PYTHONNOUSERSITE=1
unset PYTHONPATH

# 3. DYNAMIC ENVIRONMENT DETECTION
# This command finds the path to 'medgemma' for whoever is running the script
ENV_PATH=$(conda env list | grep -E '^format\s' | awk '{print $NF}')

if [ -z "$ENV_PATH" ]; then
    echo "ERROR: Environment 'format' not found for user $USER."
    echo "Please create it using: conda create -n format python=3.10"
    exit 1
fi

# Set the path to the actual python executable
DYNAMIC_PYTHON="${ENV_PATH}/bin/python"

echo "------------------------------------------------------------"
echo "Job ID:        $SLURM_JOB_ID"
echo "User:          $USER"
echo "Env Path:      $ENV_PATH"
echo "Using Python:  $DYNAMIC_PYTHON"
echo "------------------------------------------------------------"

# 4. RUN (Using the direct path to bypass activation bugs)
# Resolve the project root dynamically from config.yaml so this script is portable
PROJECT_ROOT=$("$DYNAMIC_PYTHON" -c "import sys; sys.path.insert(0, '$(pwd)'); from config_utils import load_config; print(load_config()['project_root'])")
echo "Project Root: $PROJECT_ROOT"
"$DYNAMIC_PYTHON" "$PROJECT_ROOT/experiment_orchestrator/run_experiments.py" --only LLaVA-Med

echo "------------------------------------------------------------"
echo "Job finished at $(date)"