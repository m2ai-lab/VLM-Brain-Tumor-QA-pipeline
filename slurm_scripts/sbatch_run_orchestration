#!/bin/bash
#SBATCH --job-name=Orchestration_run
#SBATCH --time=2-00:00:00
#SBATCH --partition=cpu
#SBATCH --ntasks-per-node=1
#SBATCH --nodes=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=20G
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err
#SBATCH --mail-user=your.email@institution.edu
#SBATCH --mail-type=ALL

# Get the absolute path to the project root (one level up from this script)
PROJECT_ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
cd "$PROJECT_ROOT" || exit 1

# Ensure logs directory exists
mkdir -p logs

if [ ! -f "${PROJECT_ROOT}/config.yaml" ]; then
    echo "ERROR: config.yaml not found in ${PROJECT_ROOT}"
    exit 1
fi

echo "------------------------------------------------------------"
echo "Job ID:        $SLURM_JOB_ID"
echo "User:          $USER"
echo "Script dir:    $SCRIPT_DIR"
echo "Project root:  $PROJECT_ROOT"
echo "------------------------------------------------------------"

# 1. Load the cluster's Conda module
module load miniforge3

# 2. Prevent package leakage; keep PROJECT_ROOT importable
export PYTHONNOUSERSITE=1
export PYTHONPATH="${PROJECT_ROOT}:${PYTHONPATH}"

# 3. Dynamic environment detection for the orchestrator (uses 'format' env)
ENV_PATH=$(conda env list | grep -E '^format\s' | awk '{print $NF}')

if [ -z "$ENV_PATH" ]; then
    echo "ERROR: Environment 'format' not found for user $USER."
    echo "Please create it using: conda create -n format python=3.10"
    exit 1
fi

DYNAMIC_PYTHON="${ENV_PATH}/bin/python"
echo "Using Python:  $DYNAMIC_PYTHON"
echo "------------------------------------------------------------"

# 4. Run the orchestrator directly by path.
#    run_experiments.py adds its own PROJECT_ROOT to sys.path via __file__,
#    so no -m module magic is needed.
cd "$PROJECT_ROOT"
"$DYNAMIC_PYTHON" "${PROJECT_ROOT}/experiment_orchestrator/run_experiments.py" "$@"

echo "------------------------------------------------------------"
echo "Job finished at $(date)"