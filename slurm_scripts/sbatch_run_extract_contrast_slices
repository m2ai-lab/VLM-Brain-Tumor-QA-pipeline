#!/bin/bash
#SBATCH --job-name=Extract_contrast_slices
#SBATCH --time=4:00:00
#SBATCH --partition=cpu
#SBATCH --ntasks-per-node=1
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# Get the absolute path to the project root
PROJECT_ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
cd "$PROJECT_ROOT" || exit 1

# Ensure logs directory exists
mkdir -p logs

# ── Environment isolation ─────────────────────────────────────────────────────
module load miniforge3

export PYTHONNOUSERSITE=1
export PYTHONPATH="${PROJECT_ROOT}:${PYTHONPATH}"

# Dynamic environment detection
ENV_PATH=$(conda env list | grep -E '^format\s' | awk '{print $NF}')
DYNAMIC_PYTHON="${ENV_PATH}/bin/python"

# ── Run ───────────────────────────────────────────────────────────────────────
# All paths resolved from config.yaml by default.
# Outputs: <slice_dir>/<pdgm_id>/axial_<CONTRAST>.png
# Pass --overwrite to regenerate existing slices.
# Pass --pdgm_id UCSF-PDGM-XXXX to debug a single patient.
# Pass --no-skip_seg to also extract segmentation volumes (not recommended).
echo "Starting per-contrast axial slice extraction at $(date)"
echo "------------------------------------------------------------"

"$DYNAMIC_PYTHON" data_pipeline/extract_contrast_slices.py
echo "------------------------------------------------------------"
echo "Job finished at $(date)"
