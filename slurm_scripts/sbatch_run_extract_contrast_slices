#!/bin/bash
#SBATCH --job-name=Extract_contrast_slices
#SBATCH --time=4:00:00
#SBATCH --partition=cpu
#SBATCH --ntasks-per-node=1
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --output=/home/remote/%u/logs/%x_%j.out
#SBATCH --error=/home/remote/%u/logs/%x_%j.err

# ── Environment isolation (mirrors sbatch_run_best_slice) ─────────────────────
module load miniforge3

export PYTHONNOUSERSITE=1
export PYTHONPATH=""
export LD_LIBRARY_PATH="/home/remote/shghosh/.conda/envs/format/lib:$LD_LIBRARY_PATH"

PYTHON=/home/remote/shghosh/.conda/envs/format/bin/python
SCRIPT=/scratch/group/CX000019_DS1/vlm-brain-mri/QA-BrainTumor-VLM-UCSF-/data_pipeline/extract_contrast_slices.py

# ── Run ───────────────────────────────────────────────────────────────────────
# All paths resolved from config.yaml by default.
# Outputs: <slice_dir>/<pdgm_id>/axial_<CONTRAST>.png
# Pass --overwrite to regenerate existing slices.
# Pass --pdgm_id UCSF-PDGM-XXXX to debug a single patient.
# Pass --no-skip_seg to also extract segmentation volumes (not recommended).
echo "Starting per-contrast axial slice extraction at $(date)"
echo "------------------------------------------------------------"

$PYTHON "$SCRIPT"
echo "------------------------------------------------------------"
echo "Job finished at $(date)"
