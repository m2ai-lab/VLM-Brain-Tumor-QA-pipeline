#!/bin/bash
#SBATCH --job-name=human_dataset_creation
#SBATCH --time=06:00:00
#SBATCH --partition=cpu
#SBATCH --ntasks-per-node=1
#SBATCH --nodes=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=40G
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err
#SBATCH --mail-user=your.email@institution.edu
#SBATCH --mail-type=ALL

# Get the absolute path to the project root
PROJECT_ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
cd "$PROJECT_ROOT" || exit 1

# Ensure logs directory exists
mkdir -p logs

# 1. Load the cluster's Conda module
module load miniforge3

# 2. Prevent "Ghost" package leakage
export PYTHONNOUSERSITE=1
export PYTHONPATH="${PROJECT_ROOT}:${PYTHONPATH}"

# 3. DYNAMIC ENVIRONMENT DETECTION
ENV_PATH=$(conda env list | grep -E '^format\s' | awk '{print $NF}')

if [ -z "$ENV_PATH" ]; then
    echo "ERROR: Environment 'format' not found for user $USER."
    echo "Please create it using: conda create -n format python=3.10"
    exit 1
fi

DYNAMIC_PYTHON="${ENV_PATH}/bin/python"

# 4. Run human_dataset_creation.py
# Remove --first_n to use the default mode (most-questions-first accession ranking).
# Add --first_n to simply take the first 250 rows of the dataset in order.
"$DYNAMIC_PYTHON" "utility_scripts/data_utility/human_dataset_creation.py" \
    --first_n

# Optional: copy output to datasets root if needed
# cp "generated_artifacts/human_dataset.csv" "datasets/human_dataset.csv"

echo "------------------------------------------------------------"
echo "Job finished at $(date)"
