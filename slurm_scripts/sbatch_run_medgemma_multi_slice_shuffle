#!/bin/bash
#SBATCH --job-name=MedGemma_multi_slice_test
#SBATCH --time=2-00:00:00
#SBATCH --partition=gpu
#SBATCH --ntasks-per-node=1
#SBATCH --nodes=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=20G
#SBATCH --output=/home/remote/%u/logs/MedGemmaMulti_slice_shuffle_%j.out
#SBATCH --error=/home/remote/%u/logs/MedGemmaMulti_slice_shuffle_%j.err
#SBATCH --mail-user=shiv.ghosh@berkeley.edu
#SBATCH --mail-type=ALL

# 1. Load the cluster's Conda module
module load miniforge3

# 2. Prevent "Ghost" package leakage (The root of our earlier problems)
export PYTHONNOUSERSITE=1
unset PYTHONPATH

# 3. DYNAMIC ENVIRONMENT DETECTION
# This command finds the path to 'medgemma' for whoever is running the script
ENV_PATH=$(conda env list | grep -E '^medgemma\s' | awk '{print $NF}')

if [ -z "$ENV_PATH" ]; then
    echo "ERROR: Environment 'medgemma' not found for user $USER."
    echo "Please create it using: conda create -n medgemma python=3.10"
    exit 1
fi

# Set the path to the actual python executable
DYNAMIC_PYTHON="${ENV_PATH}/bin/python"

echo "------------------------------------------------------------"
echo "Job ID:        $SLURM_JOB_ID"
echo "User:          $USER"
echo "Env Path:      $ENV_PATH"
echo "Using Python:  $DYNAMIC_PYTHON"
echo "------------------------------------------------------------"

# 4. RUN (Using the direct path to bypass activation bugs)
$DYNAMIC_PYTHON /scratch/group/CX000019_DS1/vlm-brain-mri/QA-BrainTumor-VLM-UCSF-/testing_scripts/QA_testing_medgemma_multi_slice.py \
                    --qa_path /scratch/group/CX000019_DS1/vlm-brain-mri/reshuffled_finalized_ucsf_pdgm_pairs.csv \
                    --output_path /scratch/group/CX000019_DS1/vlm-brain-mri/QApairs/MedGemma1.5/Reshuffled_results.csv

echo "------------------------------------------------------------"
echo "Job finished at $(date)"