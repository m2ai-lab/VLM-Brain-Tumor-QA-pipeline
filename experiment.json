{
  "global": {
    "max_concurrent_jobs": 4,
    "runs_per_experiment": 3,
    "partition": "gpu",
    "gpus_per_node": 1,
    "cpus_per_task": 16,
    "mem": "20G",
    "time": "2-00:00:00",
    "mail_user": "{mail_user}",
    "mail_type": "ALL",
    "log_dir": "{log_dir}",
    "qa_path": "{qa_path}",
    "output_base": "{output_base}",
    "project_root": "{project_root}",
    "poll_interval_seconds": 30,
    "batch_size": 4
  },
  "environments": {
    "medgemma": {
      "type": "venv",
      "activate_path": "{project_root}/environments/envs/vlm-medgemma/bin/activate"
    },
    "med3dvlm": {
      "type": "venv",
      "activate_path": "{project_root}/environments/envs/vlm-med3dvlm/bin/activate"
    },
    "lingshu": {
      "type": "venv",
      "activate_path": "{project_root}/environments/envs/vlm-lingshu/bin/activate"
    },
    "medimageinsight": {
      "type": "venv",
      "activate_path": "{project_root}/environments/envs/vlm-medimageinsight/bin/activate"
    },
    "llava-med": {
      "type": "venv",
      "activate_path": "{project_root}/environments/envs/vlm-llavamed/bin/activate"
    },
    "openai": {
      "type": "venv",
      "activate_path": "{project_root}/environments/envs/vlm-orchestrator/bin/activate"
    }
  },
  "models": {
    "MedGemma1.5": {
      "enabled": true,
      "adapter": "medgemma",
      "environment": "medgemma",
      "model_path": "{medgemma_model_path}",
      "image_dir": "{slice_dir}",
      "tests": [
        {
          "name": "multi_slice",
          "variant": "multi_slice",
          "output_path": "{output_base}/MedGemma1.5/multi_slice_results.csv"
        },
        {
          "name": "single_slice",
          "variant": "single_slice",
          "output_path": "{output_base}/MedGemma1.5/single_slice_results.csv"
        },
        {
          "name": "single_slice_shuffled",
          "variant": "single_slice",
          "qa_path": "{reshuffled_qa_path}",
          "output_path": "{output_base}/MedGemma1.5/single_slice_reshuffled_results.csv"
        },
        {
          "name": "blank",
          "variant": "blank",
          "image_path": "{blank_png}",
          "output_path": "{output_base}/MedGemma1.5/blank_results.csv"
        },
        {
          "name": "multi_slice_shuffled",
          "variant": "multi_slice",
          "qa_path": "{reshuffled_qa_path}",
          "output_path": "{output_base}/MedGemma1.5/Reshuffled_results.csv"
        },
        {
          "name": "human",
          "variant": "multi_slice",
          "qa_path": "{human_qa_path}",
          "output_path": "{output_base}/MedGemma1.5/human_results.csv"
        },
        {
          "name": "montage_slice",
          "variant": "montage_slice",
          "output_path": "{output_base}/MedGemma1.5/montage_slice_results.csv"
        },
        {
          "name": "montage_slice_shuffled",
          "variant": "montage_slice",
          "qa_path": "{reshuffled_qa_path}",
          "output_path": "{output_base}/MedGemma1.5/montage_slice_reshuffled_results.csv"
        },
        {
          "name": "human_montage",
          "variant": "montage_slice",
          "qa_path": "{human_qa_path}",
          "output_path": "{output_base}/MedGemma1.5/montage_human_results.csv"
        },
        {
          "name": "human_single_slice",
          "variant": "single_slice",
          "qa_path": "{human_qa_path}",
          "output_path": "{output_base}/MedGemma1.5/human_single_slice_results.csv"
        }

      ]
    },
    "MedGemma1.5-ContrastSlices": {
      "enabled": true,
      "adapter": "medgemma",
      "environment": "medgemma",
      "model_path": "{medgemma_model_path}",
      "image_dir": "{slice_dir}",
      "tests": [
        {
          "name": "contrast_slices",
          "variant": "contrast_slices",
          "output_path": "{output_base}/MedGemma1.5/contrast_slices_results.csv"
        },
        {
          "name": "contrast_slices_shuffled",
          "variant": "contrast_slices",
          "qa_path": "{reshuffled_qa_path}",
          "output_path": "{output_base}/MedGemma1.5/contrast_slices_reshuffled_results.csv"
        }
      ]
    },
    "Med3DVLM": {
      "enabled": true,
      "adapter": "med3dvlm",
      "environment": "med3dvlm",
      "model_path": "{med3dvlm_model_path}",
      "image_dir": "{nifti_root}",
      "batch_size": 1,
      "tests": [
        {
          "name": "full_nifti",
          "variant": "full_nifti",
          "output_path": "{output_base}/Med3DVLM/Full_nifti_results.csv"
        },
        {
          "name": "blank",
          "variant": "blank",
          "image_path": "{blank_nifti}",
          "output_path": "{output_base}/Med3DVLM/blank_results.csv"
        },
        {
          "name": "full_nifti_reshuffled",
          "variant": "full_nifti",
          "qa_path": "{reshuffled_qa_path}",
          "output_path": "{output_base}/Med3DVLM/full_nifti_reshuffled_results.csv"
        },
        {
          "name": "human",
          "variant": "full_nifti",
          "qa_path": "{human_qa_path}",
          "output_path": "{output_base}/Med3DVLM/human_results.csv"
        }
      ]
    },
    "Qwen3": {
      "enabled": true,
      "adapter": "qwen",
      "environment": "medgemma",
      "model_path": "{qwen_model_path}",
      "batch_size": 8,
      "tests": [
        {
          "name": "text_only",
          "variant": "text_only",
          "output_path": "{output_base}/Qwen/text_only_results.csv"
        },
        {
          "name": "text_only_reshuffled",
          "variant": "text_only",
          "qa_path": "{reshuffled_qa_path}",
          "output_path": "{output_base}/Qwen/text_only_reshuffled_results.csv"
        },
        {
          "name": "human",
          "variant": "text_only",
          "qa_path": "{human_qa_path}",
          "output_path": "{output_base}/Qwen/human_results.csv"
        }
      ]
    },
    "MedImageInsight": {
      "enabled": true,
      "adapter": "medimageinsight",
      "environment": "medimageinsight",
      "model_path": "{medimageinsight_model_path}",
      "image_dir": "{slice_dir}",
      "batch_size": 16,
      "tests": [
        {
          "name": "single_slice",
          "variant": "single_slice",
          "output_path": "{output_base}/MedImageInsight/single_slice_results.csv"
        },
        {
          "name": "blank",
          "variant": "blank",
          "image_path": "{blank_png}",
          "output_path": "{output_base}/MedImageInsight/blank_results.csv"
        },
        {
          "name": "reshuffled",
          "variant": "single_slice",
          "qa_path": "{reshuffled_qa_path}",
          "output_path": "{output_base}/MedImageInsight/reshuffled_results.csv"
        },
        {
          "name": "human",
          "variant": "single_slice",
          "qa_path": "{human_qa_path}",
          "output_path": "{output_base}/MedImageInsight/human_results.csv"
        },
        {
          "name": "montage_slice",
          "variant": "montage_slice",
          "output_path": "{output_base}/MedImageInsight/montage_slice_results.csv"
        },
        {
          "name": "montage_slice_shuffled",
          "variant": "montage_slice",
          "qa_path": "{reshuffled_qa_path}",
          "output_path": "{output_base}/MedImageInsight/montage_slice_reshuffled_results.csv"
        },
        {
          "name": "human_montage",
          "variant": "montage_slice",
          "qa_path": "{human_qa_path}",
          "output_path": "{output_base}/MedImageInsight/montage_human_results.csv"
        }
      ]
    },
    "LLaVA-Med": {
      "enabled": true,
      "adapter": "llavamed",
      "environment": "llava-med",
      "model_path": "{llavamed_model_path}",
      "image_dir": "{slice_dir}",
      "tests": [
        {
          "name": "single_slice",
          "variant": "single_slice",
          "output_path": "{output_base}/LLaVA/single_slice_results.csv"
        },
        {
          "name": "blank",
          "variant": "blank",
          "image_path": "{blank_png}",
          "output_path": "{output_base}/LLaVA/blank_results.csv"
        },
        {
          "name": "reshuffled",
          "variant": "single_slice",
          "qa_path": "{reshuffled_qa_path}",
          "output_path": "{output_base}/LLaVA/reshuffled_results.csv"
        },
        {
          "name": "human",
          "variant": "single_slice",
          "qa_path": "{human_qa_path}",
          "output_path": "{output_base}/LLaVA/human_results.csv"
        },
        {
          "name": "montage_slice",
          "variant": "montage_slice",
          "output_path": "{output_base}/LLaVA/montage_slice_results.csv"
        }
      ]
    },
    "GPT5Mini": {
      "enabled": true,
      "adapter": "openai_versa",
      "environment": "openai",
      "model_path": "",
      "image_dir": "{slice_dir}",
      "runs_per_experiment": 2,
      "slurm_overrides": {
        "partition": "cpu",
        "gpus_per_node": 0,
        "mem": "8G",
        "time": "02:00:00",
        "cpus_per_task": 4
      },
      "tests": [
        {
          "name": "single_slice",
          "variant": "single_slice",
          "output_path": "{output_base}/GPT5Mini/single_slice_results.csv"
        },
        {
          "name": "single_slice_shuffled",
          "variant": "single_slice",
          "qa_path": "{reshuffled_qa_path}",
          "output_path": "{output_base}/GPT5Mini/single_slice_reshuffled_results.csv"
        },
        {
          "name": "blank",
          "variant": "blank",
          "image_path": "{blank_png}",
          "output_path": "{output_base}/GPT5Mini/blank_results.csv"
        },
        {
          "name": "human",
          "variant": "single_slice",
          "qa_path": "{human_qa_path}",
          "output_path": "{output_base}/GPT5Mini/human_results.csv"
        },
        {
          "name": "montage_slice",
          "variant": "montage_slice",
          "output_path": "{output_base}/GPT5Mini/montage_slice_results.csv"
        }
      ]
    },
    "Lingshu-32B": {
      "enabled": true,
      "adapter": "lingshu",
      "environment": "lingshu",
      "model_path": "{lingshu_model_path}",
      "image_dir": "{slice_dir}",
      "runs_per_experiment": 1,
      "batch_size": 2,
      "slurm_overrides": {
        "partition": "gpu",
        "gpus_per_node": 1,
        "mem": "64G",
        "time": "2-00:00:00",
        "cpus_per_task": 8
      },
      "tests": [
        {
          "name": "single_slice",
          "variant": "single_slice",
          "output_path": "{output_base}/Lingshu/single_slice_results.csv"
        },
        {
          "name": "single_slice_shuffled",
          "variant": "single_slice",
          "qa_path": "{reshuffled_qa_path}",
          "output_path": "{output_base}/Lingshu/single_slice_reshuffled_results.csv"
        },
        {
          "name": "montage_slice",
          "variant": "montage_slice",
          "output_path": "{output_base}/Lingshu/montage_slice_results.csv"
        },
        {
          "name": "montage_slice_shuffled",
          "variant": "montage_slice",
          "qa_path": "{reshuffled_qa_path}",
          "output_path": "{output_base}/Lingshu/montage_slice_reshuffled_results.csv"
        },
        {
          "name": "blank",
          "variant": "blank",
          "image_path": "{blank_png}",
          "output_path": "{output_base}/Lingshu/blank_results.csv"
        },
        {
          "name": "human",
          "variant": "single_slice",
          "qa_path": "{human_qa_path}",
          "output_path": "{output_base}/Lingshu/human_results.csv"
        }
      ]
    }
  }
}